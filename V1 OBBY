-----------------------------------------
-- LOOPING AUTO TELEPORT & AUTO REBIRTH
-----------------------------------------
task.spawn(function()
    while true do
        local currentStage = getCurrentStageNumber()

        -- Jika Auto Rebirth aktif dan player sudah mencapai Stage 100 ke atas
        if autoRebirthToggle and currentStage and currentStage >= maxStageBeforeRebirth then
            attemptRebirth()
            manualStageTracker = 1
            task.wait(1)
        end

        if autoToggle then
            if tick() < pauseEndTime then
                task.wait(0.1)
                continue
            end

            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")

            if hrp and hum and hum.Health > 0 then
                local nextStageNum = 1

                if currentStage then
                    nextStageNum = currentStage + 1
                    manualStageTracker = nextStageNum
                else
                    nextStageNum = manualStageTracker
                    manualStageTracker = manualStageTracker + 1
                end

                local targetObj = findTargetStageObject(nextStageNum)
                local targetCFrame = getCPPosition(targetObj)

                if targetCFrame then
                    -- Teleportasi tepat di atas checkpoint
                    hrp.CFrame = targetCFrame * CFrame.new(0, heightOffset, 0)

                    -- Memberikan animasi melompat & dorongan gaya ke atas (efek melayang/lompat)
                    hum:ChangeState(Enum.HumanoidStateType.Jumping)
                    hrp.AssemblyLinearVelocity = Vector3.new(0, jumpForce, 0)
                end

                task.wait(teleDelay)
            else
                task.wait(0.1)
            end
        else
            task.wait(0.2)
        end
    end
end)
