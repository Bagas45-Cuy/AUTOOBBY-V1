-- Fungsi untuk mendapatkan nomor stage player saat ini dari leaderstats
local function getCurrentStageNumber()
    local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
    if leaderstats then
        local stage = leaderstats:FindFirstChild("Stage") or leaderstats:FindFirstChild("Stage ") or leaderstats:FindFirstChild("Checkpoint")
        if stage and tonumber(stage.Value) then
            return tonumber(stage.Value)
        end
    end
    return nil
end

-- Fungsi mencari objek stage yang tepat berdasarkan angka
local function findTargetStageObject(targetStageNum)
    local possibleNames = {
        tostring(targetStageNum),
        "Stage" .. tostring(targetStageNum),
        "Stage " .. tostring(targetStageNum),
        "CP" .. tostring(targetStageNum),
        "CP " .. tostring(targetStageNum),
        "Checkpoint" .. tostring(targetStageNum)
    }

    -- Cari di folder umum lebih dulu
    local possibleFolders = {"CheckPoints", "Checkpoints", "Stages", "SpawnPoints", "Spawns", "CPs"}
    for _, fName in ipairs(possibleFolders) do
        local folder = workspace:FindFirstChild(fName)
        if folder then
            for _, name in ipairs(possibleNames) do
                local found = folder:FindFirstChild(name)
                if found then return found end
            end
        end
    end

    -- Jika tidak ada folder, cari langsung di Workspace
    for _, name in ipairs(possibleNames) do
        local found = workspace:FindFirstChild(name)
        if found then return found end
    end

    -- Jika masih tidak ketemu, telusuri seluruh objek di workspace
    for _, item in ipairs(workspace:GetDescendants()) do
        if item:IsA("BasePart") or item:IsA("Model") then
            local numInName = tonumber(item.Name:match("^%d+$") or item.Name:match("stage%s*(%d+)") or item.Name:match("cp%s*(%d+)"))
            if numInName == targetStageNum then
                return item
            end
        end
    end

    return nil
end

-- Fungsi mengambil CFrame dari objek stage
local function getCPPosition(cpObject)
    if not cpObject then return nil end
    if cpObject:IsA("BasePart") then
        return cpObject.CFrame
    elseif cpObject:IsA("Model") then
        if cpObject.PrimaryPart then
            return cpObject.PrimaryPart.CFrame
        else
            local part = cpObject:FindFirstChildWhichIsA("BasePart", true)
            if part then return part.CFrame end
        end
    end
    return nil
end

-----------------------------------------
-- FUNGSI AUTO REBIRTH LEBIH AGRESIF
-----------------------------------------
local function attemptRebirth()
    -- A. Eksekusi Remote Event / Remote Function
    for _, item in ipairs(game:GetDescendants()) do
        if item:IsA("RemoteEvent") or item:IsA("RemoteFunction") then
            local name = item.Name:lower()
            if name:find("rebirth") or name:find("prestige") or name:find("reset") then
                pcall(function()
                    if item:IsA("RemoteEvent") then
                        item:FireServer()
                    elseif item:IsA("RemoteFunction") then
                        item:InvokeServer()
                    end
                end)
            end
        end
    end

    -- B. Eksekusi Simulasi Klik pada Tombol UI Rebirth di PlayerGui
    local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if playerGui then
        for _, guiItem in ipairs(playerGui:GetDescendants()) do
            if guiItem:IsA("TextButton") or guiItem:IsA("ImageButton") then
                local btnName = guiItem.Name:lower()
                local btnText = (guiItem:IsA("TextButton") and guiItem.Text:lower()) or ""
                if btnName:find("rebirth") or btnText:find("rebirth") or btnText:find("yes") or btnText:find("confirm") then
                    pcall(function()
                        for _, connection in ipairs(getconnections(guiItem.MouseButton1Click)) do
                            connection:Fire()
                        end
                        for _, connection in ipairs(getconnections(guiItem.Activated)) do
                            connection:Fire()
                        end
                    end)
                end
            end
        end
    end

    -- C. Sentuh Part Rebirth di Workspace jika berbentuk Physical Part
    for _, item in ipairs(workspace:GetDescendants()) do
        if item:IsA("BasePart") and item.Name:lower():find("rebirth") then
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp and firetouchinterest then
                pcall(function()
                    firetouchinterest(hrp, item, 0)
                    task.wait(0.1)
                    firetouchinterest(hrp, item, 1)
                end)
            end
        end
    end
end

